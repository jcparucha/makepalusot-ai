{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "allowJs": false,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "ignoreDeprecations": "6.0",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["node"],
        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/js/*"]
        }
    },

    "include": ["resources/js/**/*.ts", "resources/js/**/*.vue"]
}
